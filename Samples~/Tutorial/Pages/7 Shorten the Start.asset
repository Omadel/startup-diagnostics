  m_Script: {fileID: 11500000, guid: ff771ccdf4150419d9ff4d342b069aae, type: 3}
  m_Name: 7 Shorten the Start
  m_EditorClassIdentifier: Unity.Tutorials.Core.Editor::Unity.Tutorials.Core.Editor.TutorialPage
  Title:
    m_Untranslated: Shorten the longest step
  m_Paragraphs:
    m_Items:
    - m_Type: 0
      Title:
        m_Untranslated: Shorten the longest step
      Text:
        m_Untranslated: "Each step has its own levers:\n\n<b>scripts_start</b>: the
          initialization of the engine, which grows with the size of the build, its
          code and its preloaded assets.\n<b>first_scene_loaded</b>: the splash screen
          of Unity when it shows (2.1 s in a new project), then the loading of the
          first scene: keep it a small boot scene.\n<b>first_frame</b>: the Awake
          and Start of the first scene, and its first rendering.\nYour own milestones
          after them: Addressables, the loading of the playable scene.\n\nWhen the
          start cannot get shorter, it can feel shorter: the launch screen of the
          package shows the same icon from the launch screen of the OS to the first
          playable screen, in <b>Project Settings \u203A Startup Diagnostics</b>.\n\nThe
          <a href=\"https://github.com/Omadel/startup-diagnostics/blob/main/Documentation~/optimization-guide.md\">optimization
          guide</a> describes each lever, how to apply it and how to measure its
          effect."
