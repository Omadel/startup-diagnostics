  m_Script: {fileID: 11500000, guid: ff771ccdf4150419d9ff4d342b069aae, type: 3}
  m_Name: 2 End of the Start
  m_EditorClassIdentifier: Unity.Tutorials.Core.Editor::Unity.Tutorials.Core.Editor.TutorialPage
  Title:
    m_Untranslated: End the start on the first playable screen
  m_Paragraphs:
    m_Items:
    - m_Type: 0
      Title:
        m_Untranslated: End the start on the first playable screen
      Text:
        m_Untranslated: 'By default, the start ends at the first frame of the first
          scene of the build. If the first playable screen comes later, for example
          after a boot scene loads the game scene, tell the timeline: defer the end
          before that first frame, then end the start on that screen.'
      m_CodeSample: "using Javienne.StartupDiagnostics;\nusing UnityEngine;\nusing
        UnityEngine.SceneManagement;\n\npublic class Boot : MonoBehaviour\n{\n   
        private void Awake()\n    {\n        StartupTimeline.DeferEnd();\n    }\n\n   
        private void Start()\n    {\n        var loading = SceneManager.LoadSceneAsync(\"Game\");\n       
        _ = StartupTimeline.EndAtFirstFrameAsync(loading, \"game_loaded\", \"game_frame\");\n   
        }\n}"
      m_PostInstructionImage: {fileID: 0}
      m_Tutorial: {fileID: 0}
      m_Image: {fileID: 0}
      m_VideoUrl: 
      m_Video: {fileID: 0}
      m_Media:
