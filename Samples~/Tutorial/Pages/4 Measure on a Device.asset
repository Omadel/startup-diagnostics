        m_UnmaskedViews: []
      m_Summary: 
      m_Description: 
      m_InstructionBoxTitle: 
      m_InstructionText: 
      m_TutorialButtonText: 
    - m_Type: 1
      Title:
        m_Untranslated: Measure the start
      Text:
        m_Untranslated: 'Under <b>New measure</b>, choose the platform and the device,
          keep <b>A new build</b>, then press <b>Measure</b>. Building needs the
          platform to be the active build target.


          The clean install deletes
          the data of the game on the device: the measure asks first. It takes a
          few minutes, mostly for the build; the bar under the toolbar shows how
          far it is. Leave the device alone until the end.'
      m_CodeSample: 
