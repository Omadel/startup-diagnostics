  m_Script: {fileID: 11500000, guid: ff771ccdf4150419d9ff4d342b069aae, type: 3}
  m_Name: 4 Measure on a Device
  m_EditorClassIdentifier: Unity.Tutorials.Core.Editor::Unity.Tutorials.Core.Editor.TutorialPage
  Title:
    m_Untranslated: Measure the start on a device
  m_Paragraphs:
    m_Items:
    - m_Type: 0
      Title:
        m_Untranslated: Prepare the device
      Text:
        m_Untranslated: "Plug in an Android device with USB debugging, or an iOS
          device that trusts this Mac with Developer Mode on. Keep it unlocked with
          its screen on during the measure.\n\nOn Android, the measure uses adb and
          bundletool from the Android module of Unity. On iOS, it needs Xcode, and
          signs the game with the team of <b>Player Settings \u203A Signing Team
          ID</b>."
      m_CodeSample: 
      m_PostInstructionImage: {fileID: 0}
      m_Tutorial: {fileID: 0}
      m_Image: {fileID: 0}
      m_VideoUrl: 
      m_Video: {fileID: 0}
      m_Media:
        m_ContentType: 0
